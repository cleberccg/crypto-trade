# =============================================================================
# CRYPTO Trading BOT - Ambiente Configuracao
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA envie .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Binance API
# -----------------------------------------------------------------------------
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true
BINANCE_BASE_URL=https://testnet.binance.vision

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# desenvolvimento (XAMPP/MySQL local)
# Banco de dados_URL=mysql+pymysql://root:@127.0.0.1:3306/crypto_bot
# desenvolvimento fallback (SQLite)
DATABASE_URL=sqlite:///data/crypto_bot.db
# Producao: PostgreSQL
# Banco de dados_URL=postgresql+psycopg2://user:password@localhost:5432/crypto_bot
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Parametros de Trading
# -----------------------------------------------------------------------------
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h
MAX_OPEN_TRADES=3
STAKE_CURRENCY=USDT
# Percentual of portfolio per trade (0.02 = 2%)
STAKE_AMOUNT_PCT=0.02

# -----------------------------------------------------------------------------
# Gestao de risco
# -----------------------------------------------------------------------------
# Maximo risk per trade as fraction of portfolio (0.01 = 1%)
MAX_RISK_PER_TRADE_PCT=0.01
# Stop loss padrao como fracao do preco de entrada (0.02 = 2%)
DEFAULT_STOP_LOSS_PCT=0.02
# Take profit padrao como fracao do preco de entrada (0.04 = 4%)
DEFAULT_TAKE_PROFIT_PCT=0.04
# Padrao trailing stop as fraction (0.015 = 1.5%)
DEFAULT_TRAILING_STOP_PCT=0.015
# Risk/Reward ratio
RISK_REWARD_RATIO=2.0
# ATR multiplier for stop-loss calculation (default 2.0)
ATR_STOP_MULTIPLIER=2.0

# -----------------------------------------------------------------------------
# Optimizer
# -----------------------------------------------------------------------------
OPTIMIZER_ENABLED=True
OPTIMIZER_WORKERS=16
OPTIMIZER_MAX_COMBINATIONS=5000
CHECKPOINT_INTERVAL=50
SAVE_PROGRESS_EVERY=50
BACKUP_AFTER_OPTIMIZATION=True
AUTO_VALIDATE=True
AUTO_BACKUP=True
AUTO_GENERATE_REPORT=True

# -----------------------------------------------------------------------------
# Statistical validation after optimization
# -----------------------------------------------------------------------------
MIN_TRADES=100
MIN_PROFIT_FACTOR=1.40
MAX_DRAWDOWN=15
MIN_WIN_RATE=35
MIN_EXPECTANCY=0
MIN_SHARPE=1.0

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=true

# -----------------------------------------------------------------------------
# Aplicacao
# -----------------------------------------------------------------------------
# desenvolvimento | Producao
ENVIRONMENT=development
# Quando verdadeiro, nenhuma ordem real e enviada
PAPER_TRADING=true

# -----------------------------------------------------------------------------
# Integracao n8n
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/crypto-bot
N8N_API_KEY=your_n8n_api_key_here

# -----------------------------------------------------------------------------
# Dashboard API (FastAPI)
# -----------------------------------------------------------------------------
API_JWT_SECRET=change-me-in-production
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRE_MINUTES=480
API_USER=admin
API_PASSWORD=admin
API_ROLE=administrator
API_OPERATOR_USER=operator
API_OPERATOR_PASSWORD=operator
API_VIEWER_USER=viewer
API_VIEWER_PASSWORD=viewer

# -----------------------------------------------------------------------------
# Telegram Monitoring (optional, disabled by default)
# -----------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_SEND_PROGRESS=true
TELEGRAM_PROGRESS_INTERVAL_MINUTES=30
TELEGRAM_SEND_ERRORS=true
TELEGRAM_SEND_SUCCESS=true
TELEGRAM_SEND_REPORTS=true
